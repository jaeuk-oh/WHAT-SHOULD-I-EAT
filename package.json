{
  "name": "naengteol-mate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "//engines": "firebase-admin 14가 node>=22를 요구한다. 배포 환경 Node를 고정하지 않으면 firebase-admin/auth 로드가 실패해 guard를 쓰는 모든 /api 엔드포인트가 500이 난다. CI(.github/workflows/ci.yml)와 같은 버전으로 맞춘다.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx watch scripts/dev-api.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "seed": "tsx scripts/seed-recipes.ts",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-naengteol \"node --import tsx --test tests/firestore-rules.test.ts\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.10.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.47.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.24",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
