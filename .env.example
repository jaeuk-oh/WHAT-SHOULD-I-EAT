# ---------- OpenAI (서버 전용) ----------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# ---------- Firebase Admin (서버 전용) ----------
# 서비스 계정 JSON 전체를 넣거나 base64로 인코딩해 넣는다.
# 미설정 시 레이트리밋이 인스턴스 메모리 폴백으로 동작하고(방어력 약함) 회원 탈퇴가 불가하다.
#   Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
FIREBASE_SERVICE_ACCOUNT=
# 비기본 데이터베이스를 쓰는 경우 (미지정 시 VITE_FIREBASE_DATABASE_ID 사용)
FIRESTORE_DATABASE_ID=

# ---------- Firebase 웹 SDK (클라이언트 노출됨) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# AI Studio가 만든 프로젝트는 비기본 데이터베이스를 쓴다 — 필수
VITE_FIREBASE_DATABASE_ID=
