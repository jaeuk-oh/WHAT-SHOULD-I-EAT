# ---------- NVIDIA NIM (서버 전용) ----------
# https://build.nvidia.com 에서 발급. OpenAI 호환 엔드포인트(integrate.api.nvidia.com)를 쓴다.
NVIDIA_API_KEY=nvapi-...
# 레시피 추천/조리법 생성용 텍스트 모델. 기본값은 빠른 응답을 위한 경량 MoE 모델.
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# 영수증 이미지 인식용 비전-언어 모델.
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# ---------- Firebase Admin (서버 전용) ----------
# 서비스 계정 JSON 전체를 넣거나 base64로 인코딩해 넣는다.
# 미설정 시 레이트리밋이 인스턴스 메모리 폴백으로 동작하고(방어력 약함) 회원 탈퇴가 불가하다.
#   Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
FIREBASE_SERVICE_ACCOUNT=
# 비기본 데이터베이스를 쓰는 경우 (미지정 시 VITE_FIREBASE_DATABASE_ID 사용)
FIRESTORE_DATABASE_ID=

# ---------- YouTube Data API v3 (서버 전용, 선택) ----------
# 레시피 영상 검색에 쓴다. 없으면 영상 섹션이 조용히 숨겨지고 나머지는 정상 동작한다.
#   Google Cloud Console > API 및 서비스 > YouTube Data API v3 사용 설정 > API 키 생성
# 무료 할당량 10,000 유닛/일, 검색 1회당 100 유닛 → 하루 100회. 결과는 7일간 캐시된다.
YOUTUBE_API_KEY=

# ---------- 임박 재료 알림 (서버 전용) ----------
# Vercel Cron(매일 00:00 UTC)이 api/cron/expiry-notify 를 호출해 D-1 이하 재료를
# 인앱 알림함(벨 아이콘)에 쌓는다. 이메일은 보내지 않는다.
# CRON_SECRET 이 없으면 엔드포인트가 503으로 차단된다 — 알림을 쓸 거라면 반드시 설정한다.
#   Vercel Cron 은 Authorization: Bearer <CRON_SECRET> 헤더로 호출한다.
CRON_SECRET=

# ---------- Firebase 웹 SDK (클라이언트 노출됨) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# AI Studio가 만든 프로젝트는 비기본 데이터베이스를 쓴다 — 필수
VITE_FIREBASE_DATABASE_ID=
# 선택. Firebase 콘솔 > 프로젝트 설정 > 통합 > Google Analytics 연결 후 나오는 측정 ID(G-...).
# 사용자가 화면에서 뭘 먼저 누르는지 보는 용도(screen_view 등). 비워두면 이벤트 로깅은 조용히 꺼진다.
VITE_FIREBASE_MEASUREMENT_ID=
